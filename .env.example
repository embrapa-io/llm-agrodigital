# Portas no host. A 80 é a porta padrão dos clientes (URL sem porta, sem TLS
# — intranet do DC; terminação TLS futura fica no Kong, como nos demais GPU
# servers). A 11434 é mantida por compatibilidade com o padrão da plataforma.
PORT_HTTP=80
PORT_OLLAMA=11434
PORT_SGLANG=11435

# Diretório dos modelos do Ollama no host
LLM_PATH=/data/ollama

# =============================================================================
# Ollama (CPU-only) — embeddings
# =============================================================================
# As GPUs ficam dedicadas ao SGLang. O Ollama roda em CPU apenas para servir
# modelos de embedding (bge-m3, qwen3-embedding:0.6b, embeddinggemma:300m).
# ⚠️ CPU e RAM desta workstation ainda não inventariadas (`lscpu`, `free -h`,
# `df -h`) — os valores abaixo são CONSERVADORES; recalibrar após o inventário.

# Context window size (default: 2048)
OLLAMA_CONTEXT_LENGTH=8192

# Flash Attention - faster inference
OLLAMA_FLASH_ATTENTION=1

# New inference engine (improved performance)
OLLAMA_NEW_ENGINE=1

# Requisições concorrentes (CPU de workstation — subir após inventário)
OLLAMA_NUM_PARALLEL=2

# Máximo de modelos simultâneos em memória (RAM a confirmar)
OLLAMA_MAX_LOADED_MODELS=3

# Keep models loaded (reduces cold start latency)
OLLAMA_KEEP_ALIVE=24h

# Threads OpenMP por instância — conservador para CPU desktop; ajustar para
# ~metade dos cores físicos após `lscpu`.
OMP_NUM_THREADS=8

# Afinidade de threads (inócuo em single-socket; manter)
OMP_PROC_BIND=close
OMP_PLACES=cores

# =============================================================================
# SGLang — Qwen3-VL-8B-Instruct AWQ (INT4) em TP=2
# =============================================================================
# cyankiwi/Qwen3-VL-8B-Instruct-AWQ-4bit (checkpoint AWQ consagrado do
# Qwen3-VL-8B-Instruct, out/2025, Apache 2.0, ~6,5 GiB): denso 8B, multimodal
# (texto + imagem, OCR em 32 idiomas, GUI grounding), tool calling, ótimo
# pt-BR. Contexto nativo 262.144. AWQ INT4 roda nas RTX 3070 (Ampere, sm_86)
# via kernels Marlin — este hardware NÃO tem FP8 nativo (exclusivo de
# Ada/Hopper+), então checkpoints FP8 só via Marlin weight-only (menos KV).
#
# Racional (ago/2026): não existe Qwen3.6 pequeno (lineup: 27B e 35B-A3B —
# AWQ do 27B tem ~15,5 GiB e não cabe nos 16 GB com KV). O PrismML Bonsai 27B
# (1-bit/ternário do Qwen3.6-27B) caberia, mas só roda no fork de llama.cpp
# deles (sem SGLang/vLLM, VL não confirmado) — fica na watch list.

# Token do HuggingFace Hub — recomendado para evitar rate-limiting no download
# e obrigatório para modelos gated. Obter em https://huggingface.co/settings/tokens
# (escopo "Read" é suficiente). Usado pelo ./download-model.sh.
#HF_TOKEN=

# Diretório no host onde o modelo foi baixado (use ./download-model.sh).
SGLANG_MODEL_PATH=/data/models/qwen3-vl-8b-instruct-awq

# Repositório HuggingFace do modelo (usado apenas pelo download-model.sh).
SGLANG_MODEL_REPO=cyankiwi/Qwen3-VL-8B-Instruct-AWQ-4bit

# Nome exposto na API (campo "model" nas requisições)
SGLANG_SERVED_MODEL_NAME=qwen3-vl-8b

# Tensor Parallelism — 2 GPUs (RTX 3070 8 GB)
SGLANG_TP_SIZE=2

# Contexto em tokens. Orçamento de VRAM (MEDIDO no boot de 04/08/2026):
# KV do Qwen3-VL-8B ≈ 144 KiB/token em FP16 (36 camadas × 8 KV heads × 128).
# Com mem-fraction 0.85: max_total_num_tokens=37117 — 1 request de 32K cheio
# + margem; os 4 slots trabalham por preempção (contextos típicos de dev são
# curtos). Para 65536: habilitar KV em FP8 (ver SGLANG_EXTRA_ARGS) e revalidar.
SGLANG_CONTEXT_LENGTH=32768

# Requisições concorrentes (baseado no KV disponível — ver conta acima)
SGLANG_MAX_RUNNING_REQUESTS=4

# Batch size máximo dos CUDA graphs — manter = MAX_RUNNING_REQUESTS (graphs
# maiores nunca rodam; warmup enxuto evita o timeout de 600s do launcher).
SGLANG_CUDA_GRAPH_MAX_BS=4

# Fração estática da VRAM reservada. Em 8 GB/GPU não há gordura: com 0.88
# sobraram só 0,24 GB livres pós-KV (sem folga para capturar CUDA graphs);
# 0.85 validado em 04/08/2026 (boot 37 s, KV 37117 tokens).
SGLANG_MEM_FRACTION=0.85

# GPUs visíveis para o SGLang (vazio = todas)
SGLANG_NVIDIA_VISIBLE_DEVICES=all

# Parsers (por família de modelo).
# Qwen3-VL Instruct usa o template padrão <tool_call> JSON dos Qwen2.5/Qwen3
# → parser 'qwen' (o antigo 'qwen25' foi deprecado; NÃO usar 'qwen3_coder',
# que é o formato do Qwen3.6). Instruct não tem thinking; o reasoning-parser
# 'qwen3' fica como no-op.
SGLANG_REASONING_PARSER=qwen3
SGLANG_TOOL_CALL_PARSER=qwen

# Permite --context-length acima do derivado do modelo (necessário p/ YaRN).
SGLANG_ALLOW_OVERWRITE_LONGER_CONTEXT_LEN=0

# Flags extras do SGLang — acrescentados no fim do comando.
#
# KV cache em FP8 (storage — Ampere não tem FP8 de cômputo, mas o
# armazenamento E5M2 funciona e ~dobra o pool de KV → viabiliza 65536):
#   SGLANG_EXTRA_ARGS=--kv-cache-dtype fp8_e5m2
#   (validar qualidade em contexto longo antes de fixar)
#
# Se a visão não funcionar de primeira, testar: --chat-template qwen2-vl
SGLANG_EXTRA_ARGS=
